# Copy to .env (never committed) and restart the API with `make api`.
# AI assist (review, deep scan, fixes) needs one of these keys. Everything else works without it.

# Claude (Anthropic API). Needs API credits on the account.
ANTHROPIC_API_KEY=

# Gemini (Google AI Studio key).
GEMINI_API_KEY=

# Optional. Which one to use when both keys are set: anthropic or gemini.
# Default: anthropic if its key is set, otherwise gemini.
# PATCHPROOF_AI_PROVIDER=gemini

# Optional. Pin one model. Defaults: claude-opus-5-5, or for Gemini
# gemini-2.5-flash, falling back to newer Flash models when it is busy.
# PATCHPROOF_AI_MODEL=gemini-2.5-flash

# Optional. Set to off to disable AI even with a key present.
# PATCHPROOF_AI=off
